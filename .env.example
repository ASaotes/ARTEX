# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 管理端口放在可信反代之后时开启，按 X-Forwarded-For/X-Real-IP 限流与锁定
ARTEX_TRUST_PROXY_HEADERS=
# stdio MCP 加固（默认全部保持旧行为）：禁用 / 命令+参数白名单 / 降权用户
ARTEX_MCP_STDIO_DISABLED=
ARTEX_MCP_STDIO_ALLOWLIST=
ARTEX_MCP_STDIO_RUN_AS=
